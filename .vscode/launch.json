{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Accounting App",
      "program": "${workspaceFolder}/src/accounting/index.js",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/src/accounting"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Accounting App",
      "program": "${workspaceFolder}/src/accounting/index.js",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/src/accounting",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Tests",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["${workspaceFolder}/src/accounting"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
